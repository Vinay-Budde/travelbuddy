<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Travel Buddy Transit</title>
    <!-- Modern Typography: Inter & Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <style>
        :root {
            --tb-navy: #0F172A;
            --tb-navy-light: #1E293B;
            --tb-blue: #2563EB;
            --tb-blue-hover: #1D4ED8;
            --tb-saffron: #EA580C;
            --tb-saffron-hover: #C2410C;
            --tb-green: #059669;
            --tb-green-subtle: #ECFDF5;
            --tb-card-border: #E2E8F0;
            --tb-bg: #F8FAFC;
        }

        body {
            font-family: 'Plus Jakarta Sans', 'Inter', -apple-system, sans-serif;
            background-color: var(--tb-bg);
            color: #1E293B;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* Glassmorphism & Modern Navigation */
        .navbar-custom {
            background: rgba(15, 23, 42, 0.96);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            padding: 0.85rem 1.75rem;
        }

        .navbar-brand {
            font-weight: 800;
            font-size: 1.35rem;
            color: #ffffff !important;
            letter-spacing: -0.02em;
            display: flex;
            align-items: center;
            gap: 0.6rem;
        }

        .brand-icon {
            width: 36px;
            height: 36px;
            background: linear-gradient(135deg, #EA580C, #F97316);
            border-radius: 10px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: white;
            box-shadow: 0 4px 10px rgba(234, 88, 12, 0.35);
        }

        .nav-link {
            color: #94A3B8 !important;
            font-weight: 600;
            font-size: 0.925rem;
            padding: 0.55rem 1rem !important;
            border-radius: 8px;
            transition: all 0.2s ease;
        }

        .nav-link:hover, .nav-link.active {
            color: #FFFFFF !important;
            background: rgba(255, 255, 255, 0.08);
        }

        /* Hero Banner Gradient */
        .hero-banner {
            background: linear-gradient(135deg, #0F172A 0%, #1E293B 100%);
            color: white;
            border-radius: 20px;
            padding: 3rem 2.5rem;
            position: relative;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(15, 23, 42, 0.12);
        }

        .hero-banner::after {
            content: '';
            position: absolute;
            top: -60px;
            right: -60px;
            width: 300px;
            height: 300px;
            background: radial-gradient(circle, rgba(234, 88, 12, 0.25) 0%, rgba(234, 88, 12, 0) 70%);
            border-radius: 50%;
            pointer-events: none;
        }

        /* Card Enhancements */
        .tb-card {
            background: #FFFFFF;
            border: 1px solid var(--tb-card-border);
            border-radius: 16px;
            box-shadow: 0 4px 14px rgba(0, 0, 0, 0.03);
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .tb-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 24px rgba(0, 0, 0, 0.07);
        }

        /* Pass Product Card Styling */
        .pass-card {
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            height: 100%;
            border-radius: 16px;
            padding: 1.75rem;
            background: #ffffff;
            border: 1.5px solid #E2E8F0;
            transition: all 0.25s ease;
            position: relative;
        }

        .pass-card:hover {
            border-color: #CBD5E1;
            transform: translateY(-4px);
            box-shadow: 0 12px 28px rgba(15, 23, 42, 0.08);
        }

        .pass-card.featured {
            border: 2px solid var(--tb-blue);
            background: linear-gradient(180deg, #FFFFFF 0%, #F8FAFC 100%);
        }

        .pass-tag {
            font-size: 0.725rem;
            font-weight: 700;
            letter-spacing: 0.05em;
            text-transform: uppercase;
            padding: 0.35rem 0.75rem;
            border-radius: 20px;
        }

        /* Custom Modern Buttons */
        .btn-saffron {
            background: linear-gradient(135deg, #EA580C, #F97316);
            color: #ffffff;
            border: none;
            font-weight: 600;
            border-radius: 10px;
            padding: 0.65rem 1.4rem;
            box-shadow: 0 4px 12px rgba(234, 88, 12, 0.25);
            transition: all 0.2s ease;
        }

        .btn-saffron:hover {
            background: linear-gradient(135deg, #C2410C, #EA580C);
            color: #ffffff;
            transform: translateY(-1px);
            box-shadow: 0 6px 16px rgba(234, 88, 12, 0.35);
        }

        .btn-navy {
            background-color: var(--tb-navy);
            color: #ffffff;
            border: none;
            font-weight: 600;
            border-radius: 10px;
            padding: 0.65rem 1.4rem;
        }

        .btn-navy:hover {
            background-color: var(--tb-navy-light);
            color: #ffffff;
        }

        /* QR Scanner Animation Box */
        .scanner-frame {
            position: relative;
            width: 250px;
            height: 250px;
            margin: 0 auto;
            border: 2px dashed #CBD5E1;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #F8FAFC;
            overflow: hidden;
        }

        .scanner-laser {
            position: absolute;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, transparent, #EA580C, transparent);
            box-shadow: 0 0 10px #EA580C;
            animation: scanning 2.2s infinite ease-in-out;
        }

        @@keyframes scanning {
            0% { top: 10px; opacity: 0; }
            50% { opacity: 1; }
            100% { top: 240px; opacity: 0; }
        }

        .footer-custom {
            margin-top: auto;
            background: #ffffff;
            border-top: 1px solid var(--tb-card-border);
            padding: 1.75rem 0;
            color: #64748B;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-custom sticky-top">
            <div class="container-fluid max-w-7xl px-lg-4">
                <a class="navbar-brand" asp-page="/Index">
                    <span class="brand-icon"><i class="bi bi-bus-front-fill"></i></span>
                    <span>Travel Buddy</span>
                    <span class="badge bg-warning bg-opacity-20 text-warning ms-1" style="font-size: 0.65rem; font-weight: 700;">PROTOTYPE</span>
                </a>
                <button class="navbar-toggler text-white" type="button" data-bs-toggle="collapse" data-bs-target="#navContent">
                    <i class="bi bi-list fs-2 text-white"></i>
                </button>
                <div class="collapse navbar-collapse" id="navContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3">
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Index"><i class="bi bi-ticket-perforated me-1"></i> Pass Catalogue</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/MyPasses"><i class="bi bi-wallet2 me-1"></i> Pass Wallet</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Operator"><i class="bi bi-upc-scan me-1"></i> Conductor Terminal</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Admin"><i class="bi bi-shield-check me-1"></i> Admin Portal</a>
                        </li>
                    </ul>
                    <div class="d-flex align-items-center gap-3">
                        <a asp-page="/Login" class="text-light text-decoration-none small d-flex align-items-center gap-2 px-2 py-1 rounded hover-light">
                            <i class="bi bi-person-circle fs-5 text-warning"></i>
                            <span>Demo User</span>
                        </a>
                        <a asp-page="/MyPasses" class="btn btn-saffron btn-sm"><i class="bi bi-qr-code me-1"></i> Live Ticket</a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="container-fluid px-3 px-md-5 py-4">
        @RenderBody()
    </main>

    <footer class="footer-custom text-center">
        <div class="container">
            <div class="d-flex justify-content-center align-items-center gap-2 mb-2">
                <i class="bi bi-shield-lock-fill text-success"></i>
                <span class="small fw-semibold text-dark">Travel Buddy — Integrated Transit Pass &amp; Digital Fare Platform</span>
            </div>
            <p class="mb-0 small text-muted">
                Engineered with C# ASP.NET Core &bull; Dynamic Rotating QR &bull; Razorpay Sandbox &bull; Anti-Passback Boarding Policy
            </p>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
