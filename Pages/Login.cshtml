@page
@model TravelBuddy.Pages.LoginModel
@{
    ViewData["Title"] = "Sign In / Switch Role";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="tb-card p-4">
            <h4 class="fw-bold mb-3 text-navy text-center"><i class="bi bi-box-arrow-in-right text-warning me-2"></i> Sign In to Travel Buddy</h4>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger py-2 small">@Model.ErrorMessage</div>
            }

            <form method="post">
                <div class="mb-3">
                    <label class="form-label small fw-semibold">Email address</label>
                    <input type="email" name="Email" class="form-control" value="@Model.Email" required />
                </div>
                <div class="mb-3">
                    <label class="form-label small fw-semibold">Password</label>
                    <input type="password" name="Password" class="form-control" value="@Model.Password" required />
                </div>
                <button type="submit" class="btn btn-saffron w-100 py-2">Sign In</button>
            </form>

            <div class="p-3 bg-light rounded border mt-4">
                <div class="small fw-bold text-secondary mb-2">Quick Demo Accounts:</div>
                <div class="d-flex flex-column gap-1 small">
                    <div><strong>Passenger:</strong> <code>passenger@travelbuddy.local</code> / <code>Passenger@123456</code></div>
                    <div><strong>Conductor:</strong> <code>conductor1@travelbuddy.local</code> / <code>Operator@123456</code></div>
                    <div><strong>Admin:</strong> <code>admin@travelbuddy.local</code> / <code>Admin@123456</code></div>
                </div>
            </div>
        </div>
    </div>
</div>
